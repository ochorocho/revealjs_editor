[traverse(page, "doktype") == 1731]
  lib.contentElement.templateRootPaths.0 = EXT:fluid_styled_content/Resources/Private/Templates/
  lib.contentElement.templateRootPaths.10 = EXT:fluid_styled_content/Resources/Private/Templates/
  lib.contentElement.templateRootPaths.20 = EXT:fluid_styled_content/Resources/Private/Templates/
  lib.contentElement.partialRootPaths.0 = EXT:fluid_styled_content/Resources/Private/Partials/
  lib.contentElement.partialRootPaths.10 = EXT:fluid_styled_content/Resources/Private/Partials/
  lib.contentElement.partialRootPaths.20 = EXT:fluid_styled_content/Resources/Private/Partials/
  lib.contentElement.layoutRootPaths.0 = EXT:fluid_styled_content/Resources/Private/Layouts/
  lib.contentElement.layoutRootPaths.10 = EXT:fluid_styled_content/Resources/Private/Layouts/
  lib.contentElement.layoutRootPaths.20 = EXT:fluid_styled_content/Resources/Private/Layouts/

  # Re-snapshot the two core CTypes we allow inside a deck so they pick up
  # the freshly-reset rootPaths instead of the theme-camino-tainted ones
  # the parse-time snapshot from fluid_styled_content / theme-camino
  # captured.
  tt_content.text >
  tt_content.text =< lib.contentElement
  tt_content.text.templateName = Text

  tt_content.textmedia >
  tt_content.textmedia =< lib.contentElement
  tt_content.textmedia.templateName = Textmedia
  tt_content.textmedia.templateRootPaths.20 = EXT:revealjs_editor/Resources/Private/Templates/Container/
  tt_content.textmedia.dataProcessing.10 = files
  tt_content.textmedia.dataProcessing.10.references.fieldName = assets
  tt_content.textmedia.dataProcessing.20 = gallery

  tt_content.revealjs_slide_cover >
  tt_content.revealjs_slide_cover =< lib.contentElement
  tt_content.revealjs_slide_cover.templateName = Cover
  tt_content.revealjs_slide_cover.templateRootPaths.20 = EXT:revealjs_editor/Resources/Private/Templates/Container/
  tt_content.revealjs_slide_cover.dataProcessing.10 = TYPO3\CMS\Frontend\DataProcessing\FilesProcessor
  tt_content.revealjs_slide_cover.dataProcessing.10.references.fieldName = image

  tt_content.revealjs_slide_code >
  tt_content.revealjs_slide_code =< lib.contentElement
  tt_content.revealjs_slide_code.templateName = Code
  tt_content.revealjs_slide_code.templateRootPaths.20 = EXT:revealjs_editor/Resources/Private/Templates/Container/
  tt_content.revealjs_slide_code.dataProcessing.10 = TYPO3\CMS\Frontend\DataProcessing\DatabaseQueryProcessor
  tt_content.revealjs_slide_code.dataProcessing.10 {
    table = tx_revealjseditor_codeblock
    pidInList.field = pid
    where = parent_uid={field:uid}
    where.insertData = 1
    orderBy = sorting
    as = codeblocks
  }

  # theme-camino (and similar theme sets) leaves tt_content as a CASE with
  # no `key`, so f:render.record's cObjGetSingle('tt_content', …) falls
  # through to tt_content.default for every CType. Point CASE at the CType
  # field so the per-CType branches above are actually picked.
  tt_content.key.field = CType

  # And re-snapshot the default branch as a safety net — anything that slipped
  # past the keepItems guard (e.g. a CType from a theme we didn't account for)
  # still renders with our reset paths rather than the theme's chrome.
  tt_content.default >
  tt_content.default =< lib.contentElement

  page = PAGE
  page {
    typeNum = 0
    # Brand color OVERRIDES from the site settings (revealjs.color.*, exposed as
    # TypoScript constants) are stamped as --cmp-* custom properties on the body
    # tag — but ONLY for the ones the site actually filled in. Body is reveal's
    # .reveal-viewport, so a token inherits to both the viewport background and
    # all .reveal content. An UNSET (empty) setting emits nothing, so the token
    # falls through to the active theme's own :root default. Built as a COA with
    # per-segment `if.isTrue` (no CSS braces in Fluid — the {…} parser would eat
    # them). See settings.definitions.yaml for why these are `string`, not `color`.
    #
    # SECURITY: each value is whitelisted to a safe CSS-color charset via
    # preg_replace before it is wrapped into the inline style. This strips
    # quotes / < > / ; : { } / \ so a setting value can never break out of the
    # `style="…"` attribute (markup injection) nor inject extra CSS declarations
    # (e.g. `red;background:url(//evil)`). Keeps hex, rgb()/rgba()/hsl(), % and
    # named colors.
    bodyTagCObject = COA
    bodyTagCObject {
      5 = TEXT
      5.value = <body class="revealjs-page" style="
      10 = TEXT
      10.value = {$revealjs.color.background}
      10.if.isTrue = {$revealjs.color.background}
      10.replacement.10.search = /[^#0-9a-zA-Z(),.%\s-]/
      10.replacement.10.replace =
      10.replacement.10.useRegExp = 1
      10.noTrimWrap = |--cmp-bg:|;|
      20 = TEXT
      20.value = {$revealjs.color.text}
      20.if.isTrue = {$revealjs.color.text}
      20.replacement.10.search = /[^#0-9a-zA-Z(),.%\s-]/
      20.replacement.10.replace =
      20.replacement.10.useRegExp = 1
      20.noTrimWrap = |--cmp-text:|;|
      30 = TEXT
      30.value = {$revealjs.color.accent}
      30.if.isTrue = {$revealjs.color.accent}
      30.replacement.10.search = /[^#0-9a-zA-Z(),.%\s-]/
      30.replacement.10.replace =
      30.replacement.10.useRegExp = 1
      30.noTrimWrap = |--cmp-accent:|;|
      40 = TEXT
      40.value = {$revealjs.color.muted}
      40.if.isTrue = {$revealjs.color.muted}
      40.replacement.10.search = /[^#0-9a-zA-Z(),.%\s-]/
      40.replacement.10.replace =
      40.replacement.10.useRegExp = 1
      40.noTrimWrap = |--cmp-muted:|;|
      90 = TEXT
      90.value = ">
    }

    10 = PAGEVIEW
    10 {
      paths.10 = EXT:revealjs_editor/Resources/Private/Templates/

      variables {
        # Per-presentation theme picked on the page record. Falls back to
        # 'typo3' if the field is empty.
        theme = TEXT
        theme.field = tx_revealjseditor_theme
        theme.ifEmpty = typo3

        # Per-presentation author string — surfaced lower-left in the FE via
        # the `.reveal-author` div in Pages/Revealjs.html. Empty by default;
        # the template skips the element when not set.
        revealjsAuthor = TEXT
        revealjsAuthor.field = tx_revealjseditor_author
      }

      dataProcessing {
        # Build the reveal.js JSON config object from all tx_revealjseditor_*
        # page-record fields. Output assigned to {revealjsConfig} (default `as`).
        10 = Ochorocho\RevealJsEditor\DataProcessing\RevealJsConfigProcessor

        # Resolve the page's logo FAL reference into {pageLogos}.
        # Empty when the editor hasn't picked a logo — the template falls
        # back to `{settings.revealjs.defaultLogo}` in that case.
        20 = TYPO3\CMS\Frontend\DataProcessing\FilesProcessor
        20 {
          references.fieldName = tx_revealjseditor_logo
          references.table = pages
          as = pageLogos
        }

        # Resolve the theme CSS URL under Resources/Public/Styles/revealjs-themes/
        # (or an EXTCONF-registered path). Output assigned to {themeUrl} for a
        # single <f:asset.css> line in Pages/Revealjs.html.
        30 = Ochorocho\RevealJsEditor\DataProcessing\RevealJsThemeProcessor

        # Loads Monaco (the VS Code editor) as the single editor for code
        # blocks on the deck — anonymous viewers get it in read-only mode,
        # visual_editor's preview iframe gets it editable with
        # dataHandlerStore wiring for save-back. The template stamps
        # `data-editable="1"` on blocks rendered in edit mode; the mount
        # module reads that flag per-block to decide read-only vs editable.
        # Side-effect-only processor; no template variables produced.
        40 = Ochorocho\RevealJsEditor\DataProcessing\RevealJsMonacoAssetsProcessor
      }
    }
  }
[end]

# Outside-the-condition fallback for the custom slide CTypes — required
# for sites that don't load a theme set that rewrites tt_content (no harm
# done on doktype-1731 pages, where the in-condition block above
# re-declares the branches against the reset lib.contentElement).
tt_content.revealjs_slide_cover =< lib.contentElement
tt_content.revealjs_slide_cover {
    templateName = Cover
    templateRootPaths.20 = EXT:revealjs_editor/Resources/Private/Templates/Container/
    dataProcessing.10 = TYPO3\CMS\Frontend\DataProcessing\FilesProcessor
    dataProcessing.10.references.fieldName = image
}

tt_content.revealjs_slide_code =< lib.contentElement
tt_content.revealjs_slide_code {
    templateName = Code
    templateRootPaths.20 = EXT:revealjs_editor/Resources/Private/Templates/Container/
    dataProcessing.10 = TYPO3\CMS\Frontend\DataProcessing\DatabaseQueryProcessor
    dataProcessing.10 {
        table = tx_revealjseditor_codeblock
        pidInList.field = pid
        where = parent_uid={field:uid}
        where.insertData = 1
        orderBy = sorting
        as = codeblocks
    }
}
